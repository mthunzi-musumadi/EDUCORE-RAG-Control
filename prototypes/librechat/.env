# ==============================================================================
# Educore Enterprise RAG — LibreChat Prototype Environment Configuration
# Governed by EDUCORE_AI_FRAMEWORK (ISO/IEC 42001 & Purview Boundaries)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3080

# Standalone MongoDB URI (Managed by run_mongo.js on port 27017)
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# ========================================================
# Application Branding & White-Labeling
# ========================================================
APP_TITLE="Educore RAG Control"
CUSTOM_FOOTER="Educore AI Framework • Institutional System • Audited"
HELP_AND_FAQ_URL="https://internal-docs.educore.local/governance"

# ========================================================
# Identity & Access Management
# ========================================================
ALLOW_REGISTRATION=false
ALLOW_INVITATIONS=false
ALLOW_SHARED_LINKS=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# Session Security
JWT_SECRET=educore-super-secure-jwt-secret-key-32-chars-minimum
JWT_REFRESH_SECRET=educore-super-secure-refresh-key-32-chars-minimum
SESSION_EXPIRY=900000
CREDS_KEY=f34be427bc246b9a89c92ff3397989d41b07ec3269b82098d6333917dcfdc907
CREDS_IV=b9432607147a4eb18b320267f81515ef

# ========================================================
# Backend Integration
# ========================================================
EDUCORE_BACKEND_API_KEY=educore-internal-secure-key
EDUCORE_BACKEND_URL=http://127.0.0.1:8000/v1
CONFIG_PATH=librechat.yaml
ADMIN_PANEL_URL=http://localhost:3080/admin

# Disable external cloud providers by default (purely internal Educore engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
